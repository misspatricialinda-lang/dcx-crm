        "jsCode": "// Change only after implementing CONTRACTS.md and testing credentials.\n// Request payload cannot override this configuration.\nreturn $input.all().map(item => ({json:{input:item.json.body ?? item.json,config:{dry_run:true,api_base:'https://YOUR-DASHBOARD.example',contract_version:'ups-automation-v1'}}}));"
