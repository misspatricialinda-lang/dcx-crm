    {
      "parameters": {
        "jsCode": "const x=$input.first().json;\nif(x.claimed!==true || x.authorized!==true || x.approval_status!=='approved' || x.current_revision!==x.approved_revision || !x.lease_token || !x.outbound_id || !x.payload_hash) throw new Error('Outbound is not approved and claimed');\nif(x.send_mode !== 'live') throw new Error('Backend is not in live sending mode');\nif(!Number.isFinite(Date.parse(x.lease_expires_at)) || Date.parse(x.lease_expires_at)<=Date.now()) throw new Error('Outbound lease expired');\nreturn [{json:x}];"
      },
