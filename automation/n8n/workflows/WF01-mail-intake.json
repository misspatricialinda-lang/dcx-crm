    {
      "parameters": {
        "jsCode": "const rows=$input.all();\nif(rows.length!==1) throw new Error('Exactly one task per execution required');\nconst {input:payload,config}=rows[0].json;\nif(!payload || typeof payload!=='object' || Array.isArray(payload)) throw new Error('Invalid payload');\nfor(const key of [\"mailbox_id\",\"provider_message_id\",\"from\",\"subject\",\"body_text\"]) if(payload[key]===undefined || payload[key]===null || payload[key]==='') throw new Error('Missing '+key);\nif(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(payload.from)) throw new Error('Invalid sender');\npayload.from=payload.from.trim().toLowerCase();\nif(!['incoming','outgoing'].includes(payload.direction) || typeof payload.historical!=='boolean') throw new Error('Explicit direction and historical flag required');\nreturn [{json:{payload,config,correlation_id:payload.correlation_id ?? String($execution.id)}}];"
      },
