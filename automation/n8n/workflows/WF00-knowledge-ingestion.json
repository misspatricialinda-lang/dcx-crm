        1440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...{\"status\":\"sample_only\",\"next_action\":\"Extract, embed and review document before approved-only search can retrieve it\"},workflow:'WF00',dry_run:true,persisted:false}}];"
      },
      "id": "WF00-7",
      "name": "Sample result - no external calls",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$input.first().json;\nconst u=new URL(x.config.api_base);\nif(u.protocol!=='https:' || u.hostname.endsWith('.example') || u.username || u.password || u.search || u.hash) throw new Error('Configure deployed HTTPS backend first');\nreturn [{json:x}];"
      },
      "id": "WF00-8",
      "name": "Require configured HTTPS backend",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate input').first().json.config.api_base + '/api/automation/v1/knowledge/extract' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contract_version:'ups-automation-v1',workflow:'WF00',correlation_id:$('Validate input').first().json.correlation_id,input:$('Validate input').first().json.payload,previous:$json,execution_id:$execution.id}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "WF00-9",
      "name": "Claim document version and extract text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$input.first().json;\nif(!x.document_id || !Number.isInteger(x.version) || !Array.isArray(x.pages) || !x.pages.length || !x.content_hash) throw new Error('Invalid extraction');\nconst chunks=[];\nfor(const page of x.pages){if(typeof page.text!=='string' || page.page==null) throw new Error('Page provenance missing'); const s=page.text.trim(); for(let start=0; start<s.length; start+=1400){chunks.push({chunk_index:chunks.length,content:s.slice(start,start+1600),source_page:String(page.page)}); if(chunks.length>500) throw new Error('Document exceeds phase-one limit');}}\nif(!chunks.length) throw new Error('No text extracted; OCR or manual review required');\nreturn [{json:{document_id:x.document_id,version:x.version,content_hash:x.content_hash,chunks,status:'draft'}}];"
      },
      "id": "WF00-10",
      "name": "Validate extraction and split passages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validate input').first().json.config.api_base + '/api/automation/v1/knowledge/embed' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contract_version:'ups-automation-v1',workflow:'WF00',correlation_id:$('Validate input').first().json.correlation_id,input:$('Validate input').first().json.payload,previous:$json,execution_id:$execution.id}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "WF00-11",
      "name": "Embed passages with configured model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$input.first().json;\nif(!x.document_id || !x.content_hash || !Number.isInteger(x.version) || !x.embedding_model || !Number.isInteger(x.dimension) || x.dimension<1 || !Array.isArray(x.chunks) || !x.chunks.length) throw new Error('Embedding metadata missing');\nfor(const c of x.chunks) if(!c.content || !Array.isArray(c.embedding) || c.embedding.length!==x.dimension || !c.embedding.every(Number.isFinite)) throw new Error('Invalid vector');\nreturn [{json:{...x,status:'draft',requires_document_publication:true}}];"
      },
