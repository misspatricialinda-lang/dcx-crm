    },
    {
      "parameters": {
        "jsCode": "// Change only after implementing CONTRACTS.md and testing credentials.\n// Request payload cannot override this configuration.\nreturn $input.all().map(item => ({json:{input:item.json.body ?? item.json,config:{dry_run:true,api_base:'https://YOUR-DASHBOARD.example',contract_version:'ups-automation-v1'}}}));"
      },
      "id": "WF00-4",
      "name": "Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows=$input.all();\nif(rows.length!==1) throw new Error('Exactly one task per execution required');\nconst {input:payload,config}=rows[0].json;\nif(!payload || typeof payload!=='object' || Array.isArray(payload)) throw new Error('Invalid payload');\nfor(const key of [\"document_id\",\"version\",\"storage_path\"]) if(payload[key]===undefined || payload[key]===null || payload[key]==='') throw new Error('Missing '+key);\n\nreturn [{json:{payload,config,correlation_id:payload.correlation_id ?? String($execution.id)}}];"
      },
      "id": "WF00-5",
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dry-run",
              "leftValue": "={{ $json.config.dry_run }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "WF00-6",
      "name": "Dry run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
