        "operation": "executeQuery",
        "query": "WITH sent AS (\n INSERT INTO email_messages(thread_id,mailbox_id,provider_key,provider_ref,direction,sender,to_addresses,subject,body_text,body_loaded,has_attachments,occurred_at)\n SELECT c.thread_id,c.mailbox_id,'crm-send:'||c.draft_id::text||':'||c.revision::text,$4,'outgoing',c.mailbox_address,c.to_addresses,c.subject,c.current_body,true,$5::boolean,now()\n FROM (SELECT d.id AS draft_id,d.thread_id,d.revision,d.current_body,d.subject,d.to_addresses,t.mailbox_id,mb.address AS mailbox_address\n       FROM email_drafts d JOIN email_threads t ON t.id=d.thread_id JOIN email_mailboxes mb ON mb.id=t.mailbox_id\n       WHERE d.id=$1::uuid AND d.thread_id=$2::uuid AND d.status='sending') c\n ON CONFLICT(mailbox_id,provider_key) DO UPDATE SET body_text=EXCLUDED.body_text RETURNING id,thread_id\n), marked AS (\n UPDATE email_drafts SET status='sent',provider_draft_id=$4,updated_at=now()\n WHERE id=$1::uuid AND status='sending' AND EXISTS(SELECT 1 FROM sent) RETURNING id\n), thread AS (\n UPDATE email_threads SET status='waiting_customer',last_message_at=now(),updated_at=now()\n WHERE id=$2::uuid AND EXISTS(SELECT 1 FROM marked) RETURNING id\n)\nSELECT (SELECT id FROM sent) AS message_id,(SELECT id FROM marked) AS draft_id,(SELECT id FROM thread) AS thread_id;",
