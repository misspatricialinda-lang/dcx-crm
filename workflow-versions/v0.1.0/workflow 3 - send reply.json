        "jsCode": "const draft=$json;\nconst claim=$('Claim Draft for Send').first().json;\nconst setup=$('Validate Send Input').first().json;\nconst expected=String(claim.to_addresses?.[0]||'').trim().toLowerCase();\nconst recipients=list=>(list||[]).map(r=>String(r.emailAddress?.address||'').trim().toLowerCase()).filter(Boolean);\nconst actual=recipients(draft.toRecipients);\nconst cc=recipients(draft.ccRecipients);\nconst bcc=recipients(draft.bccRecipients);\nconst mailbox=String(claim.mailbox_address||'').trim().toLowerCase();\nconst from=String(draft.from?.emailAddress?.address||'').trim().toLowerCase();\nconst recipient_safe=!!expected&&!setup.own_addresses.includes(expected)&&expected!==mailbox&&\n  mailbox===setup.mailbox_address&&actual.length===1&&actual[0]===expected&&cc.length===0&&bcc.length===0&&\n  draft.isDraft===true&&draft.conversationId===claim.provider_thread_key&&\n  (!from||setup.own_addresses.includes(from));\nreturn [{json:{recipient_safe,expected,actual,cc,bcc,mailbox,conversation_id:draft.conversationId}}];"
