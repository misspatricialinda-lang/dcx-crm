        "jsCode": "\nconst body = $json.body || {};\nconst action = (body.action || '').toString().trim().toLowerCase();\nconst allowed = ['rewrite', 'regenerate', 'save', 'send'];\nconst errors = [];\nif (!allowed.includes(action)) errors.push('Invalid or missing action. Allowed: ' + allowed.join(', '));\nif (!body.thread_id) errors.push('thread_id is required');\nif (['rewrite', 'regenerate', 'save', 'send'].includes(action) && !body.draft_id) errors.push('draft_id is required for ' + action);\nif (action === 'save' && !body.body_text) errors.push('body_text is required for save');\nif (errors.length) {\n  return [{ json: { valid: false, error: errors.join('; '), action: action || 'unknown', thread_id: body.thread_id || null, draft_id: body.draft_id || null } }];\n}\nreturn [{ json: {\n  valid: true,\n  action,\n  thread_id: String(body.thread_id),\n  draft_id: body.draft_id ? String(body.draft_id) : null,\n  instruction: body.instruction || '',\n  manual_body_text: body.body_text || null,\n  attachment_ids: Array.isArray(body.attachment_ids) ? body.attachment_ids : [],\n  request_id: body.request_id || null,\n  actor: body.actor || 'owner',\n} }];\n"
