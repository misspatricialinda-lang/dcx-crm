        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are the email drafting engine for DCX, a professional services company.\nYou write email replies on behalf of the owner. You are NOT a chatbot.\nReturn ONLY the email body content. No subject line, no greeting explanation, no markdown fences, no commentary.\nNever invent prices, dates, technical details, commitments, or customer information that is not in the conversation or customer record.\nPreserve useful information from the existing draft unless the owner explicitly asks to remove or change it.\nKeep a professional, concise DCX tone. Sign off as the DCX team.\nThe conversation context may abbreviate older messages. Do not invent details from omitted text; ask for clarification if an earlier commitment is unclear."
            },
            {
              "content": "={{ `FULL CONVERSATION:\n${$json.history}\n\nCUSTOMER / CONTACT INFO:\n${$json.customer_block}\n\nCURRENT DRAFT:\n${$json.draft_body_text}\n\nOWNER INSTRUCTION:\n${$json.instruction}\n\nTask: Modify the CURRENT DRAFT according to the owner instruction. Keep everything else useful intact. Return only the revised email body.` }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 2000,
          "temperature": 0.4
        }
      },
      "id": "26019430-a2ae-403f-a7ab-68fa3cdaa2e6",
      "name": "AI Rewrite Draft",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
