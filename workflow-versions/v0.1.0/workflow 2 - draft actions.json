    {
      "parameters": {
        "jsCode": "\nconst req = $('Validate Request').item.json;\nconst thread = $('Load Thread').item.json;\nconst draft = ($('Load Draft').item.json && $('Load Draft').item.json.id) ? $('Load Draft').item.json : null;\nlet customer = null;\ntry { const c = $('Load Customer').item.json; if (c && c.id) customer = c; } catch (e) { /* no customer on this thread */ }\nconst messages = $('Load Thread Messages').all().map(i => i.json);\nconst isInbound = m => (m.direction === 'inbound' || m.direction === 'incoming');\nconst latestInbound = [...messages].reverse().find(isInbound) || null;\n// Keep full records in Supabase; bound the context sent for draft edits and regenerations.\nconst plain = m => String(m.body_html\n  ? m.body_html.replace(/<[^>]*>/g,' ').replace(/&nbsp;/gi,' ').replace(/&amp;/gi,'&')\n  : m.body_text || '').replace(/\\s+/g,' ').trim();\nconst describe = (m,body) => '[' + (m.direction || 'unknown') + ' ' +\n  (m.occurred_at || m.created_at || '') + '] From: ' + (m.sender || '') +\n  ' To: ' + (Array.isArray(m.to_addresses) ? m.to_addresses.join(', ') : '') + '\\n' + body;\nconst older = messages.slice(0,-10);\nconst olderShown = older.length > 40 ? [...older.slice(0,2),...older.slice(-38)] : older;\nconst history = messages.length + ' messages in the conversation. Older text may be abbreviated.\\n' +\n  (olderShown.length ? olderShown.map(m=>describe(m,String(m.body_text || plain(m)).slice(0,500))).join('\\n\\n---\\n\\n') + '\\n\\n---\\n\\n' : '') +\n  messages.slice(-10).map(m=>describe(m,plain(m).slice(0,m.id===latestInbound?.id?10000:3500))).join('\\n\\n---\\n\\n') +\n  (older.length>olderShown.length ? '\\n\\n' + (older.length-olderShown.length) + ' intermediate older messages omitted from this AI context.' : '');\nif (['rewrite','save','send'].includes(req.action) && !draft) {\n  return [{ json: { fatal: 'Draft not found for draft_id ' + req.draft_id, action: req.action } }];\n}\nreturn [{ json: {\n  action: req.action,\n  thread_id: req.thread_id,\n  draft_id: draft ? String(draft.id) : null,\n  request_id: req.request_id,\n  actor: req.actor,\n  instruction: req.instruction,\n  manual_body_text: req.manual_body_text,\n  attachment_ids: JSON.stringify(req.attachment_ids || []),\n  thread_status: thread.status,\n  subject: (thread.subject || (messages[0] && messages[0].subject) || '').replace(/^re:\\s*/i, ''),\n  mailbox_id: thread.mailbox_id || (latestInbound ? latestInbound.mailbox_id : null),\n  reply_target_db_id: (draft && draft.reply_to_message_id) || (latestInbound ? latestInbound.id : null),\n  draft_body_text: draft ? (draft.current_body || '') : '',\n  draft_revision: draft ? (draft.revision || 0) : 0,\n  draft_status: draft ? draft.status : 'none',\n  history,\n  latest_inbound_text: latestInbound ? plain(latestInbound).slice(0,10000) : '',\n  reply_to_addresses: draft && Array.isArray(draft.to_addresses) ? draft.to_addresses : (latestInbound && latestInbound.sender ? [latestInbound.sender] : []),\n  source_message_version: (thread.message_version != null ? thread.message_version : (latestInbound ? 1 : 1)),\n  customer_block: customer ? ('Customer: ' + (customer.name || '') + ' <' + (customer.email || '') + '> ' + (customer.phone || '')) : 'No customer record on file.',\n} }];\n"
      },
