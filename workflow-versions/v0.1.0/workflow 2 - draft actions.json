    {
      "parameters": {
        "jsCode": "\nconst ctx = $('Build AI Context').item.json;\nconst src = $json;\nlet text = '';\n// OpenAI Responses API (simplified): output is an array of message items with content parts.\nif (Array.isArray(src.output)) {\n  const parts = [];\n  for (const item of src.output) {\n    if (item && item.type === 'message' && Array.isArray(item.content)) {\n      for (const c of item.content) {\n        if (c && c.type === 'output_text' && typeof c.text === 'string') parts.push(c.text);\n      }\n    }\n  }\n  text = parts.join('\\n').trim();\n} else if (Array.isArray(src.content)) {\n  text = src.content.filter(b => b && b.type === 'text').map(b => b.text || '').join('\\n').trim();\n} else if (typeof src.text === 'string') {\n  text = src.text.trim();\n}\nif (!text) return [{ json: { fatal: 'AI returned an empty draft', action: ctx.action } }];\nreturn [{ json: { ...ctx, new_body_text: text, new_revision: (ctx.draft_revision || 0) + 1, revision_reason: ctx.action === 'rewrite' ? ('AI rewrite: ' + (ctx.instruction || 'no instruction')) : 'AI regenerate' } }];\n"
      },
