# Server-only credentials. Never prefix these with VITE_.
APP_LOGIN_EMAIL=
# Use at least 12 characters.
APP_LOGIN_PASSWORD=
# Generate at least 32 random characters. Changing this signs out existing sessions.
APP_SESSION_SECRET=

# Server-only Supabase connection. No Supabase Auth or browser API key is used.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Conversation analysis. Keep the OpenAI key on the server. Embedding model must
# match the one used to populate the existing Supabase documents vector table.
OPENAI_API_KEY=
OPENAI_CONVERSATION_MODEL=gpt-5.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: at least 32 random characters. Allows n8n to READ customer lookup only.
AUTOMATION_API_TOKEN=

# Microsoft 365 business mailbox. Server-only; see docs/microsoft-mail-setup.md.
# Choose microsoft or hostinger. If omitted, the configured provider is detected.
MAIL_PROVIDER=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX=
# Required for delegated sign-in in production. Must exactly match the Azure Web redirect URI.
# Example: https://dashboard.example.com/api/microsoft-oauth-callback
MICROSOFT_REDIRECT_URI=
# Optional when the deployed public origin cannot be inferred.
APP_BASE_URL=

# Hostinger Mail API. Server-only; see docs/hostinger-mail-setup.md.
# This is the Hostinger Mail API token, not the mailbox password and not a hosting API token.
HOSTINGER_MAIL_API_TOKEN=
# Use either the AC... resource ID (preferred) or the exact mailbox address.
HOSTINGER_MAILBOX_ID=
HOSTINGER_MAILBOX=

# Separate, server-only token for the email tracking n8n worker (at least 32 random characters).
# Allows sync + leased draft jobs only. Cannot approve or send email.
EMAIL_TRACKING_TOKEN=

# Server-only n8n endpoints. Set these in Vercel Project Settings and redeploy.
N8N_CALENDAR_WEBHOOK_URL=
N8N_EMAIL_ASSISTANT_WEBHOOK_URL=
N8N_CRM_WEBHOOK_SECRET=
# Match the header configured in Workflow 2 if different.
N8N_CRM_SECRET_HEADER=x-webhook-secret

# Phone alerts. Generate one VAPID key pair; keep the private key server-only.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# At least 32 random characters, shared only with the database webhook.
PUSH_DISPATCH_TOKEN=
